# =============================================================================
# [PARCIAL | NIVEL A: copiar literal] Variables de entorno
# -----------------------------------------------------------------------------
# ConfigModule.forRoot({ isGlobal: true }) en app.module.ts lee este archivo
# automaticamente (busca un ".env" en la raiz del proyecto).
# Se leen con: configService.get<string>('NOMBRE', 'valorPorDefecto')
#
# Si el enunciado pide otra ruta o varios entornos:
#   ConfigModule.forRoot({ isGlobal: true, envFilePath: '.env.development' })
# =============================================================================

PORT=3000

# Secreto para firmar los JWT. En un proyecto real NUNCA se sube al repo:
# se anade .env al .gitignore y se deja un .env.example con las claves vacias.
JWT_SECRET=dev-secret-key
JWT_EXPIRES_IN=24h
